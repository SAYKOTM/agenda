# Copiá este archivo a docker/evolution-api/.env y completá los valores reales.
# docker/evolution-api/.env está en .gitignore -- nunca commitees valores reales.

# Tiene que ser el MISMO valor que EVOLUTION_API_KEY en supabase/functions/.env -- es la key que
# usan las Edge Functions (evolutionClient.ts) para autenticarse contra esta instancia.
# Generalo con: openssl rand -hex 24
EVOLUTION_API_KEY=

# Password de la base Postgres dedicada de Evolution API (contenedor evolution-postgres, no
# Supabase). No la necesita nada más -- generá cualquier valor random.
# Generalo con: openssl rand -hex 24
EVOLUTION_DB_PASSWORD=
