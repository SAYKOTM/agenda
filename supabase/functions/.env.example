# Copiá este archivo a supabase/functions/.env y completá los valores reales.
# supabase/functions/.env está en .gitignore -- nunca commitees claves reales.

# Stripe (suscripciones SaaS)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# URL pública de la app (se usa para armar el link "Ver mi cita" en los correos y los redirects de Stripe)
APP_URL=http://localhost:5173

# Resend (notificaciones por correo, ver migración 0027) -- resend.com, free tier: 3000 emails/mes.
# RESEND_FROM_EMAIL tiene que ser una dirección de un dominio verificado en Resend (o
# onboarding@resend.dev mientras no verifiques dominio propio, pero ese remitente solo entrega a
# la casilla dueña de la cuenta de Resend -- sirve para probar, no para producción real).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Secreto compartido entre Postgres (pg_net) y la Edge Function send-notification: mismo valor acá
# y en el secret de Vault "notification_dispatch_secret" (ver instrucciones al inicio de 0027).
# Generalo con: openssl rand -hex 24
NOTIFICATION_DISPATCH_SECRET=

# Rating de Google en la landing pública (ver migración 0031/0032). GOOGLE_PLACES_API_KEY es la
# key de Google Cloud con "Places API" habilitada -- a diferencia de VITE_GOOGLE_MAPS_API_KEY
# (.env.example de la raíz), esta SÍ es secreta: nunca la expongas al frontend, solo la usa esta
# función server-side. GOOGLE_RATING_REFRESH_SECRET es el mismo patrón que
# NOTIFICATION_DISPATCH_SECRET, mismo valor acá y en el secret de Vault "google_rating_refresh_secret".
GOOGLE_PLACES_API_KEY=
GOOGLE_RATING_REFRESH_SECRET=

# Evolution API (WhatsApp, ver docker/evolution-api/). EVOLUTION_API_KEY tiene que ser el MISMO
# valor que EVOLUTION_API_KEY en docker/evolution-api/.env -- Evolution rechaza cualquier llamada
# que no mande esta key. Generalo con: openssl rand -hex 24
EVOLUTION_BASE_URL=http://localhost:8080
EVOLUTION_API_KEY=
