      "typeVersion": 2,
      "position": [-200, 260],
      "webhookId": "agenda-booking-reminder"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-secret-created",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-secret-created",
      "name": "IF: Validar Secreto (Created)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, -260]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-secret-status",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-secret-status",
      "name": "IF: Validar Secreto (Status Changed)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "cond-secret-reminder",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-secret-reminder",
      "name": "IF: Validar Secreto (Reminder)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [40, 260]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.item.json.body;\nconst fecha = DateTime.fromISO(b.start_at).setZone(b.tenant_timezone || 'America/Santiago').setLocale('es').toFormat(\"cccc dd/MM 'a las' HH:mm 'hs'\");\nreturn [{ json: { ...b, to: b.client_phone, text: `Hola ${b.client_name}, tu turno quedo agendado para el ${fecha}.\\n\\nResponde:\\n1) Confirmar\\n2) Reprogramar\\n3) Cancelar` } }];"
      },
      "id": "code-msg-created",
      "name": "Code: Mensaje Reserva Creada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, -260]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.item.json.body;\nconst textos = { confirmada: 'fue confirmado', cancelada: 'fue cancelado', completada: 'fue marcado como completado', 'no-show': 'quedo registrado como no asistido' };\nconst detalle = textos[b.status] || ('cambio de estado a ' + b.status);\nreturn [{ json: { ...b, to: b.client_phone, text: `Hola ${b.client_name}, tu turno ${detalle}.` } }];"
      },
      "id": "code-msg-status",
      "name": "Code: Mensaje Cambio de Estado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 0]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.item.json.body;\nconst fecha = DateTime.fromISO(b.start_at).setZone(b.tenant_timezone || 'America/Santiago').setLocale('es').toFormat('HH:mm');\nreturn [{ json: { ...b, to: b.client_phone, text: `Hola ${b.client_name}, te recordamos tu turno hoy a las ${fecha} (en 2 horas).\\n\\nResponde:\\n1) Confirmar\\n2) Reprogramar\\n3) Cancelar` } }];"
      },
      "id": "code-msg-reminder",
      "name": "Code: Mensaje Recordatorio 24h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [280, 260]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_BASE_URL }}/message/sendText/{{ $json.professional_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"number\": $json.to, \"text\": $json.text } }}",
        "options": {}
      },
      "id": "http-send-whatsapp",
      "name": "HTTP: Enviar WhatsApp (Evolution API)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 0],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-send-ok",
              "leftValue": "={{ $json.key }}",
              "rightValue": "",
              "operator": { "type": "any", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-send-ok",
      "name": "IF: Envio OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/mark_notification_result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"p_notification_id\": (() => { try { return $('Webhook: Booking Created').item.json.body.notification_id } catch(e) { try { return $('Webhook: Booking Status Changed').item.json.body.notification_id } catch(e2) { return $('Webhook: Booking Reminder').item.json.body.notification_id } } })(), \"p_success\": true, \"p_error\": null } }}",
        "options": {}
      },
      "id": "http-mark-ok",
      "name": "HTTP: Marcar Notificacion Enviada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/mark_notification_result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"p_notification_id\": (() => { try { return $('Webhook: Booking Created').item.json.body.notification_id } catch(e) { try { return $('Webhook: Booking Status Changed').item.json.body.notification_id } catch(e2) { return $('Webhook: Booking Reminder').item.json.body.notification_id } } })(), \"p_success\": false, \"p_error\": ($json.error && $json.error.message) ? $json.error.message : 'error desconocido al enviar whatsapp' } }}",
        "options": {}
      },
      "id": "http-mark-fail",
      "name": "HTTP: Marcar Notificacion Fallida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1000, 100]
    }
  ],
