VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-supabase-status-anon-key

# Google Maps (mapa + reseñas en la landing pública, ver 0031_google_maps_reviews.sql).
# API key con "Maps Embed API" habilitada. A diferencia de las otras API keys del proyecto, esta
# SÍ va expuesta al navegador (así funciona el embed de Google) -- restringila por HTTP referrer
# a tu dominio en Google Cloud Console, no la trates como secreta.
VITE_GOOGLE_MAPS_API_KEY=

# Avisos push del panel (PWA del profesional, ver docs/pwa-avisos-push.md). Es la MITAD PÚBLICA
# del par VAPID: viaja al navegador a propósito, igual que la key de Google Maps de arriba. La
# privada nunca va acá -- va en los secretos de las Edge Functions de Supabase.
# Generá el par con: node scripts/generate-vapid-keys.mjs
# Si falta, el panel funciona igual pero el botón "Activar avisos" avisa que no están configurados.
VITE_VAPID_PUBLIC_KEY=
